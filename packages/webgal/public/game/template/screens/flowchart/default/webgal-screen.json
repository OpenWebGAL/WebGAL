{
  "screen": "flowchart",
  "variantId": "default",
  "name": "分支流程图",
  "version": "1.0.0",
  "entry": "index.js",
  "style": "style.scss",
  "parts": [
    {
      "id": "main",
      "name": "流程图页面容器",
      "selector": ".Flowchart_main",
      "allowLayoutEdit": true
    },
    {
      "id": "top",
      "name": "顶部栏",
      "selector": ".flowchart_top",
      "allowLayoutEdit": true
    },
    {
      "id": "title",
      "name": "水印标题",
      "selector": ".flowchart_title",
      "allowLayoutEdit": true
    },
    {
      "id": "sidebar",
      "name": "分支列表栏",
      "selector": ".flowchart_sidebar",
      "allowLayoutEdit": true
    },
    {
      "id": "tabButton",
      "name": "分支标签",
      "selector": ".flowchart_tab",
      "allowLayoutEdit": false
    },
    {
      "id": "canvasArea",
      "name": "画布视口",
      "selector": ".flowchart_content",
      "allowLayoutEdit": true
    }
  ]
}
